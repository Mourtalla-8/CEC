    {
      "name": "1. Login usager",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));\nconst body = pm.response.json();\npm.test('rôle handicap', () => pm.expect(body.data.user.role).to.eql('handicap'));\npm.environment.set('tokenHandicap', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailHandicap}}\",\n  \"motDePasse\": \"{{motDePasseHandicap}}\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Connexion unifiée. Le rôle est déduit par le serveur. Stocke data.token dans {{tokenHandicap}}."
      },
      "response": []
    },
    {
      "name": "2. Créer une demande (usager)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));\nconst body = pm.response.json();\npm.test('statut en_attente', () => pm.expect(body.data.statut).to.eql('en_attente'));\npm.environment.set('demandeId', body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenHandicap}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"nouvelle\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/demandes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "demandes"
          ]
        },
        "description": "Rôle handicap requis. type = nouvelle | renouvellement (ancienneCarte requis pour un renouvellement). Stocke data.id dans {{demandeId}}."
      },
      "response": []
    },
    {
      "name": "3. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));\nconst body = pm.response.json();\npm.test('rôle admin', () => pm.expect(body.data.user.role).to.eql('admin'));\npm.environment.set('tokenAdmin', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"motDePasse\": \"{{motDePasseAdmin}}\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Admin créé par `npm run seed`. Stocke data.token dans {{tokenAdmin}}."
      },
      "response": []
    },
    {
      "name": "4. Lister les demandes (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));\nconst body = pm.response.json();\npm.test('la demande créée est listée', () => {\n  const ids = body.data.demandes.map(d => d.id);\n  pm.expect(ids).to.include(pm.collectionVariables.get('demandeId'));\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/demandes?statut=en_attente&type=tous&page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "demandes"
          ],
          "query": [
            {
              "key": "statut",
              "value": "en_attente",
              "description": "tous | en_attente | en_cours_traitement | validee | rejetee"
            },
            {
              "key": "type",
              "value": "tous",
              "description": "tous | nouvelle | renouvellement"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": "",
              "description": "Numéro de demande, nom, prénom ou email",
              "disabled": true
            }
          ]
        },
        "description": "Rôle admin requis. Liste paginée + statistiques par statut."
      },
      "response": []
    },
    {
      "name": "5. Prendre en charge la demande (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));\npm.test('statut en_cours_traitement', () => pm.expect(pm.response.json().data.statut).to.eql('en_cours_traitement'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statut\": \"en_cours_traitement\",\n  \"commentairesAdmin\": \"Dossier complet, traitement démarré\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/demandes/{{demandeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "demandes",
            "{{demandeId}}"
          ]
        },
        "description": "Assigne la demande à l'admin connecté."
      },
      "response": []
    },
    {
      "name": "6. Valider la demande (admin) - crée la carte",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));\nconst res = pm.response.json().data;\npm.test('statut validee', () => pm.expect(res.statut).to.eql('validee'));\npm.test('dateTraitement renseignée', () => pm.expect(res.dateTraitement).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statut\": \"validee\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/demandes/{{demandeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "demandes",
            "{{demandeId}}"
          ]
        },
        "description": "Pour une demande de type nouvelle : crée la carte CEC (valable 1 an). Pour rejeter : {\"statut\": \"rejetee\", \"motifRejet\": \"...\"}."
      },
      "response": []
    }
